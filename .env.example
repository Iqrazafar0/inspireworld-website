# Public URL of the live site (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.inspireworldgarments.com

# Where quotation requests are emailed. Defaults to the email in src/content/site.ts.
ENQUIRY_TO_EMAIL=info@inspireworldgarments.com

# Optional but recommended: send through the company mailbox.
# Use the SMTP settings from the email provider for info@inspireworldgarments.com.
# If left empty, the site uses FormSubmit instead (see README).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
