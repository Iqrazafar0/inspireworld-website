# Public URL of the live site (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.inspireworld.ae

# Where quotation requests are emailed. Defaults to the email in src/content/site.ts.
ENQUIRY_TO_EMAIL=subhan.mondal525@gmail.com

# Optional but recommended: send through your own mailbox.
# Gmail: turn on 2-Step Verification, create an App password (myaccount.google.com/apppasswords),
# then fill these in. If left empty, the site uses FormSubmit instead (see README).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
